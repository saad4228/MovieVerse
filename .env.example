# Documentation only: values here must remain empty or safe public defaults.
# Local Worker secrets belong in ignored .dev.vars, NOT in this example file.
# See docs/REPOSITORY_SECURITY.md for local setup and production separation.
# Optional administrator secret. Set privately in your host's Worker secrets.
ADMIN_TOKEN=
# Optional Playwright target (local default below).
TEST_BASE_URL=http://127.0.0.1:5173
# Cloudflare D1 uses the DB binding; no database connection URL is required.
# Preserve an existing .dev.vars and .wrangler/state; never overwrite them with examples.
# Optional authorised cinema inventory adapter; see docs/INTEGRATIONS.md.
LIVE_SHOWTIMES_ENDPOINT=
LIVE_SHOWTIMES_TOKEN=
SHOWTIMES_MODE=directory
# Set true only after a licensed feed has been approved and mapped. Never use mock here.
LIVE_SHOWTIMES_APPROVED=false
# No live payment provider or email service is configured.

# Optional server-side metadata refresh; never expose this in public client variables.
TMDB_READ_TOKEN=
# Alternative v3 API key. Prefer TMDB_READ_TOKEN; configure one, never NEXT_PUBLIC_*.
TMDB_API_KEY=
